PORT=8080
ENVIRONMENT=production
LOG_LEVEL=info
JWT_SECRET=change_me_with_32_plus_chars_minimum
SESSION_SECRET=change_me_with_32_plus_chars_minimum

# Database (MongoDB)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=visto-easy

# Alias opzionali
DATABASE_URL=
MONGO_URL=
MONGODB_URL=
DATABASE_NAME=visto-easy

# Queue / cache
REDIS_URL=

# Storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=true

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Notifications
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Visto Easy
SENDGRID_API_BASE=
FRONTEND_RESET_PASSWORD_URL=

# Avvisi operativi su Telegram (gokit/notifyx): avvio, arresto, panic, MongoDB non raggiungibile.
# Usa lo stesso bot e la stessa chat di Uptime Kuma per avere tutti gli avvisi in un unico posto.
OPS_TELEGRAM_BOT_TOKEN=
OPS_TELEGRAM_CHAT_ID=

# Email (gokit/mailx): se RESEND_API_KEY è impostata si usa Resend, altrimenti SMTP.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
